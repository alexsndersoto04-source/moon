# Copiá este archivo a `keystore.properties` (está en .gitignore) con TUS valores.
# Con ese archivo presente, `assembleRelease` firma con tu clave y el APK es tuyo
# de punta a punta: nadie más podrá publicar una actualización firmada por vos.
#
# Cómo generar el keystore (una sola vez, NO lo pierdas):
#
#   keytool -genkeypair -v \
#     -keystore moonshare-release.jks \
#     -alias moonshare \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# y escribí la contraseña que uses en storePassword / keyPassword.

storeFile=moonshare-release.jks
storePassword=cambiala
keyAlias=moonshare
keyPassword=cambiala
