<?xml version="1.0" encoding="utf-8"?>
<!-- El trafico va por sockets TCP crudos sobre Wi-Fi Direct (red punto a punto
     nuestra, sin AP ni internet). No hay TLS porque no hay DNS ni certificados
     valideables entre dos phones que recien se conocieron. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
