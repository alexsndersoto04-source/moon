<?xml version="1.0" encoding="utf-8"?>
<!-- AID de emulacion de tag NDEF (NFC Forum Type 4). Es el estandar, por eso
     cualquier Android con NFC sabe leerlo sin instalar nada del otro lado. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:apduServiceBanner="@drawable/nfc_banner"
    android:description="@string/nfc_service_description"
    android:requireDeviceScreenOn="true"
    android:requireDeviceUnlock="false">

    <aid-group
        android:category="other"
        android:description="@string/nfc_aid_group_description">
        <!-- 11 bytes: D2 76 00 00 85 01 01 = NDEF Tag Application -->
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
