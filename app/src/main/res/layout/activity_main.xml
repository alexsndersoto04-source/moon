<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <!-- ─── Main column ─────────────────────────────────────────────────────
         A plain LinearLayout: the previous ConstraintLayout had the preview
         card and the file strip constraining each other, which collapsed the
         camera preview to zero height. Long chains like this cannot cycle. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/brandTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:text="@string/brand"
                        android:textColor="@color/ink"
                        android:textSize="25sp" />

                    <TextView
                        android:id="@+id/brandSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:letterSpacing="0.15"
                        android:maxLines="1"
                        android:text="@string/brand_sub"
                        android:textAllCaps="true"
                        android:textColor="@color/ink_faint"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:maxWidth="118dp"
                    android:maxLines="1"
                    android:paddingStart="11dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="6dp"
                    android:text="@string/status_searching_short"
                    android:textColor="@color/ink_soft"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/settingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/settings_open"
                    android:padding="9dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Camera + live overlays. Weight 1 so it absorbs every spare pixel. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/sand"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/hairline"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_camera_preview"
                    app:implementationMode="compatible"
                    app:scaleType="fillCenter" />

                <com.airgesture.transfer.ui.HandOverlayView
                    android:id="@+id/handOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/handChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_pill"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:paddingStart="11dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="6dp"
                    android:text="@string/hand_chip_none"
                    android:textColor="@color/ink_soft"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/diagnostics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_pill"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="1dp"
                    android:padding="8dp"
                    android:textColor="@color/ink_soft"
                    android:textSize="8sp"
                    android:visibility="gone"
                    tools:text="fps 12 · 78 ms\nmano 1 · dedos 21\ncierre 0.42 · empuje 0.31\ncuadros 1204 · fallos 0" />

                <!-- Floating shelf selector -->
                <HorizontalScrollView
                    android:id="@+id/tabScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="12dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabImages"
                            style="@style/TabChip"
                            android:text="@string/tab_images" />

                        <TextView
                            android:id="@+id/tabVideos"
                            style="@style/TabChip"
                            android:text="@string/tab_videos" />

                        <TextView
                            android:id="@+id/tabPdfs"
                            style="@style/TabChip"
                            android:text="@string/tab_pdfs" />

                        <TextView
                            android:id="@+id/tabAudio"
                            style="@style/TabChip"
                            android:text="@string/tab_audio" />
                    </LinearLayout>
                </HorizontalScrollView>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live push meter + explicit send button (fallback that needs no gesture) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pushMeter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:indicatorColor="@color/accent"
                app:trackColor="@color/hairline"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />

            <TextView
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/ink"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/send_now"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Transport log: always visible so a failed send is never silent. -->
        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="26dp"
            android:ellipsize="start"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:textColor="@color/ink_faint"
            android:textSize="9sp" />

        <!-- Local file shelf -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="166dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filesList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:textColor="@color/ink_faint"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="No hay imágenes en el dispositivo" />
        </FrameLayout>

        <!-- Transfer progress + guidance -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="26dp"
            android:visibility="gone"
            app:indicatorColor="@color/ink"
            app:trackColor="@color/hairline"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:text="@string/hint_idle"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ─── Permission gate ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ivory"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:text="@string/perm_title"
            android:textColor="@color/ink"
            android:textSize="23sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/perm_body"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/permButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/perm_cta" />

        <TextView
            android:id="@+id/permSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:text="@string/perm_settings"
            android:textColor="@color/ink_soft"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
