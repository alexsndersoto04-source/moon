<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/settings_title"
            android:textColor="@color/ink"
            android:textSize="25sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.02"
            android:text="@string/settings_subtitle"
            android:textColor="@color/ink_faint"
            android:textSize="12sp" />

        <!-- ── Cámara ─────────────────────────────────────────────────── -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_camera_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cameraFront"
                style="@style/CameraChip"
                android:text="@string/settings_camera_front" />

            <TextView
                android:id="@+id/cameraBack"
                style="@style/CameraChip"
                android:text="@string/settings_camera_back" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_camera_help"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />

        <!-- ── Sensibilidad ───────────────────────────────────────────── -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_sensitivity" />

        <TextView
            android:id="@+id/sensitivityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sensitivitySlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="62"
            android:progressTint="@color/ink"
            android:thumbTint="@color/ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_sensitivity_help"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />

        <!-- ── Comportamiento ─────────────────────────────────────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/calibrateButton"
            style="@style/Widget.AirGesture.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/calibrate_action" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_behaviour" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchFistSend"
            style="@style/SettingsSwitch"
            android:text="@string/settings_fist_send" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:text="@string/settings_fist_send_help"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSkeleton"
            style="@style/SettingsSwitch"
            android:text="@string/settings_skeleton" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchHaptics"
            style="@style/SettingsSwitch"
            android:text="@string/settings_haptics" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAwake"
            style="@style/SettingsSwitch"
            android:text="@string/settings_awake" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDiagnostics"
            style="@style/SettingsSwitch"
            android:text="@string/settings_diagnostics" />

        <!-- ── Conexión ───────────────────────────────────────────────── -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_connection" />

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/diagText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_banner"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="@color/ink_soft"
            android:textSize="9sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diagShowButton"
                style="@style/Widget.AirGesture.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/diag_show" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diagCopyButton"
                style="@style/Widget.AirGesture.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/diag_copy" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/effectButton"
            style="@style/Widget.AirGesture.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_effect_preview" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="2dp"
            android:text="@string/settings_effect_help"
            android:textColor="@color/ink_faint"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            style="@style/Widget.AirGesture.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_reset" />

        <TextView
            android:id="@+id/versionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/ink_faint"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
