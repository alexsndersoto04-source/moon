<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AirGesture" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/sand</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/sand</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/hairline_strong</item>
        <item name="android:colorBackground">@color/ivory</item>
        <item name="android:windowBackground">@color/ivory</item>
        <item name="android:statusBarColor">@color/ivory</item>
        <item name="android:navigationBarColor">@color/ivory</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="materialButtonStyle">@style/Widget.AirGesture.Button</item>
    </style>

    <style name="Widget.AirGesture.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#22FFFFFF</item>
    </style>

    <style name="TextAppearance.AirGesture.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12.5sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/tab_text</item>
    </style>

    <style name="TabChip" parent="TextAppearance.AirGesture.Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:maxLines">1</item>
    </style>

</resources>
