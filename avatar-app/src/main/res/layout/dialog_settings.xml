<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Su nombre"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/setAvatarName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Luna" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tu nombre (para que te llame por él)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/setUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Alex" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Su personalidad"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/setPersonality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Ej: Eres divertida, cariñosa y un poco bromista…"
            android:minLines="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🧠 Cerebro (IA en la nube)"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/setProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/setApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pega aquí tu API key (gratis)"
            android:inputType="textPassword" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Esta app acepta claves de Google AI Studio (Gemini) o Groq; una clave de ChatGPT/OpenAI, OpenRouter u otro proveedor no sirve aquí. Gemini: aistudio.google.com → Get API key. Groq: console.groq.com → API Keys. No compartas tu clave."
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🗣️ Su voz"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/setVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="La voz IA de Gemini requiere otra petición a internet y puede tardar más. «Voz del teléfono» es local y suele empezar antes; la calidad depende de la voz española instalada en tu Android."
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🧍 Su cuerpo 3D (opcional)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/setModelUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL de tu modelo .glb (vacío = el de serie)" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Para un avatar desde TU foto: crea tu avatar gratis en readyplayer.me, copia el enlace .glb de tu avatar y pégalo aquí. Vacío usa el hombre 3D incluido."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
