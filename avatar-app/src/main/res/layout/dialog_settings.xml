<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Su nombre"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/setAvatarName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Luna" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tu nombre (para que te llame por él)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/setUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Alex" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Su personalidad"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/setPersonality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Ej: Eres divertida, cariñosa y un poco bromista…"
            android:minLines="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🧠 Cerebro (IA en la nube)"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/setProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/setApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pega aquí tu API key (gratis)"
            android:inputType="textPassword" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gemini: aistudio.google.com → «Get API key». Groq: console.groq.com → «API Keys». Sin clave, el avatar usa su cerebro local básico."
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🎨 Su apariencia"
            android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Pelo" />
        <Spinner
            android:id="@+id/setHairStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Color de pelo" />
        <Spinner
            android:id="@+id/setHairColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tono de piel" />
        <Spinner
            android:id="@+id/setSkin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Color de ropa" />
        <Spinner
            android:id="@+id/setShirt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
